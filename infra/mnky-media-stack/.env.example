# Copy to `.env` next to docker-compose.yml (gitignored) or export these before `docker compose`.
# You can also symlink a private file, e.g. `ln -sf /root/datacenter.env .env` on the LXC.
#
# Required for Gluetun (Proton WireGuard):
PROTONVPN_WIREGUARD_PRIVATE_KEY=

# qBittorrent Web UI (linuxserver image ignores these; run scripts/setup-qbittorrent-webui.sh after first boot)
# QB_WEBUI_USERNAME=admin
# QB_WEBUI_PASSWORD=

# --- Jellyfin + Jellyseerr (for scripts/bootstrap-media-integrations.py) ---
# Prefer a dedicated file `.env.secrets` (gitignored) on the LXC; do not commit real keys.
# JELLYFIN_API_KEY=          # Jellyfin Dashboard → API Keys
# JELLYFIN_URL=https://media.moodmnky.com   # Public URL (Traefik); use http://<lxc>:8096 if no proxy
# JELLYFIN_USERNAME=admin
# JELLYFIN_PASSWORD=        # Used as Jellyseerr local admin password if JELLYSEERR_ADMIN_PASSWORD unset
# JELLYFIN_INTERNAL_HOST=jellyfin     # Docker DNS (server-to-server)
# JELLYFIN_INTERNAL_PORT=8096
# JELLYSEERR_ADMIN_EMAIL=simeon.bowman@moodmnky.com
# JELLYSEERR_ADMIN_USERNAME=admin
# JELLYSEERR_ADMIN_PASSWORD=   # default: same as JELLYFIN_PASSWORD if unset
# JELLYSEERR_PUBLIC_URL=https://media-request.moodmnky.com   # Jellyseerr's own public URL (main.applicationUrl)
# (If you use JELLYSEER_* with one R in datacenter.env, scripts map it to JELLYSEERR_*)

# Optional: copy from datacenter.env for scripts/verify-media-connectivity.py (else *arr keys read from config.xml)
# SONARR_API_KEY=
# RADARR_API_KEY=
# LIDARR_API_KEY=

# NetBird (LXC host peer — scripts/ensure-netbird-peer.sh)
# NETBIRD_SETUP_TOKEN=
# NETBIRD_MANAGEMENT_URL=https://netbird.example.com

# Optional: Prowlarr FlareSolverr indexer proxy host (TrueNAS ix-app), e.g.:
# FLARESOLVERR_HOST=http://10.0.0.5:31027/
# (Not read by compose; use Settings → Indexers → Indexer proxies, or POST /api/v1/indexerProxy.)

# Optional overrides (defaults shown in docker-compose.yml):
# PROTONVPN_SERVICE_PROVIDER=protonvpn
# PROTONVPN_VPN_TYPE=wireguard
# PROTONVPN_PORT_FORWARDING=on
# PROTONVPN_PORT_FORWARDING_PROVIDER=protonvpn
# PORT_FORWARD_ONLY=on
# PROTONVPN_SERVER_COUNTRIES=United States
# GLUETUN_FIREWALL_OUTBOUND_SUBNETS=10.0.0.0/24,10.1.0.0/24
