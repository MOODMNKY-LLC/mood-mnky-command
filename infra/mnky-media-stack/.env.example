# Copy to `.env` next to docker-compose.yml (gitignored) or export these before `docker compose`.
# You can also symlink a private file, e.g. `ln -sf /root/datacenter.env .env` on the LXC.
#
# Required for Gluetun (Proton WireGuard):
PROTONVPN_WIREGUARD_PRIVATE_KEY=

# qBittorrent Web UI (linuxserver image ignores these; run scripts/setup-qbittorrent-webui.sh after first boot)
# QB_WEBUI_USERNAME=admin
# QB_WEBUI_PASSWORD=

# Optional: Prowlarr FlareSolverr indexer proxy host (TrueNAS ix-app), e.g.:
# FLARESOLVERR_HOST=http://10.0.0.5:31027/
# (Not read by compose; use Settings → Indexers → Indexer proxies, or POST /api/v1/indexerProxy.)

# Optional overrides (defaults shown in docker-compose.yml):
# PROTONVPN_SERVICE_PROVIDER=protonvpn
# PROTONVPN_VPN_TYPE=wireguard
# PROTONVPN_PORT_FORWARDING=on
# PROTONVPN_PORT_FORWARDING_PROVIDER=protonvpn
# PORT_FORWARD_ONLY=on
# PROTONVPN_SERVER_COUNTRIES=United States
# GLUETUN_FIREWALL_OUTBOUND_SUBNETS=10.0.0.0/24,10.1.0.0/24
